<Window x:Class="DashKey.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashKey 设置"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F9"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#3A3A3C" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9A9A9E" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="长按触发时长" Style="{StaticResource Label}" />
            <DockPanel Grid.Column="1" LastChildFill="True">
                <TextBlock x:Name="HoldValueText" DockPanel.Dock="Right" Width="48"
                           TextAlignment="Right" Style="{StaticResource Label}" />
                <Slider x:Name="HoldSlider" Minimum="0.5" Maximum="3" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="调出面板" Style="{StaticResource Label}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="HoldAltCheck" Content="长按 Alt" VerticalAlignment="Center" Margin="0,0,24,0" />
                <CheckBox x:Name="PanelHotkeyCheck" Content="快捷键" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="快捷键前缀" Style="{StaticResource Label}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="PrefixCombo" Width="130" VerticalAlignment="Center">
                    <ComboBoxItem Content="Alt" />
                    <ComboBoxItem Content="Ctrl + Alt" />
                </ComboBox>
                <TextBlock x:Name="PrefixHint" Style="{StaticResource Hint}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="图标清晰度" Style="{StaticResource Label}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="QualityCombo" Width="110" VerticalAlignment="Center">
                    <ComboBoxItem Content="省内存" />
                    <ComboBoxItem Content="标准" />
                    <ComboBoxItem Content="高清" />
                </ComboBox>
                <TextBlock Text="高清更清晰，但更占内存" Style="{StaticResource Hint}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="开机启动" Style="{StaticResource Label}" />
            <CheckBox x:Name="LaunchCheck" Grid.Column="1" Content="登录 Windows 后自动启动" VerticalAlignment="Center" />
        </Grid>

        <Separator Margin="0,0,0,14" />

        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ReloadButton" Content="重新读取" Padding="14,5" Margin="0,0,10,0" MinWidth="80" />
            <Button x:Name="CloseButton" Content="关闭" Padding="14,5" MinWidth="80" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
